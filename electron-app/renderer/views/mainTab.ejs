<h1>Kezdőlap</h1>

<div id="statsCarousel" class="carousel slide"  data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <div class="container text-center">
                <h4>Foglalások naponta</h4>
                <canvas id="chartBookingsPerDay" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Legforgalmasabb időszak</h4>
                <canvas id="chartPeakHours" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Leggyakrabban foglalt parkolóhelyek</h4>
                <canvas id="chartSpaces" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Napi bevétel</h4>
                <canvas id="chartRevenue" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Foglalások állapotonként</h4>
                <div style="width: 500px; height: 450px;" class="mx-auto">
                    <canvas id="chartStatus"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#statsCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#statsCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>