<h1>Kezdőlap</h1>

<div id="statsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <div class="container text-center">
                <h4>Foglalások naponta</h4>
                <canvas id="chartBookingsPerDay" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Legforgalmasabb időszak</h4>
                <canvas id="chartPeakHours" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Leggyakrabban foglalt parkolóhelyek</h4>
                <canvas id="chartSpaces" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Napi bevétel</h4>
                <canvas id="chartRevenue" height="100"></canvas>
            </div>
        </div>

        <div class="carousel-item">
            <div class="container text-center">
                <h4>Foglalások állapotonként</h4>
                <div style="width: 500px; height: 450px;" class="mx-auto">
                    <canvas id="chartStatus"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#statsCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#statsCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>

<div class="container row mt-5 mx-auto d-flex justify-content-center gap-2">
    <div class="card shadow-sm col-4" style="max-width: 300px;" data-bs-theme="dark">
        <div class="card-body p-3 d-flex flex-column justify-content-between">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold text-light"><i class="bi bi-car-front-fill me-2"></i>Jelenlegi foglaltsági
                    szint</span>
                <span class="text-secondary small" id="percentageText"></span>
            </div>

            <div class="progress" style="height:6px;">
                <div class="progress-bar bg-success" id="occopancyProgressBar" role="progressbar" style="width: 74%"
                    aria-valuenow="74" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>

            <div class="d-flex justify-content-between small text-secondary mt-2">
                <span id="occupiedCount"></span>
                <span id="freeCount"></span>
            </div>

        </div>
    </div>

    <div class="card shadow-sm col-4" style="max-width: 300px;" data-bs-theme="dark">
        <div class="card-body p-3">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-semibold text-light">
                    <i class="bi bi-currency-dollar me-1"></i>
                    Mai bevétel
                </span>
                <span class="text-secondary small">Ma</span>
            </div>

            <div class="fs-3 fw-bold text-success" id="todayRevenue"></div>

            <div class="small text-secondary mt-2">
                Összes mai foglalás bevétele
            </div>

        </div>
    </div>

    <div class="card shadow-sm col-4 p-3 d-flex flex-column justify-content-between" data-bs-theme="dark" style="max-width: 300px;">
        <div class="fw-semibold mb-1">
            <i class="bi bi-clock-history me-1"></i> Átlagos foglalási idő
        </div>
        <div class="fs-3 text-warning">1 óra 35 perc</div>
        <div class="small text-secondary">Az átlagos parkolási idő</div>
    </div>
</div>